# FieldShift — environment variable examples (no secrets)
# Copy to .env at the repo root if needed, and/or to frontend/.env and backend/.env

# --- Frontend (recommended file: frontend/.env) ---
# FastAPI URL for local development
# Empty is recommended locally (Vite proxy). Otherwise http://localhost:8000
VITE_API_BASE_URL=

# --- Backend (recommended file: backend/.env) ---
APP_ENV=development
APP_NAME=FieldShift API
CORS_ORIGINS=http://localhost:5173

# --- Later phases: leave unset for now ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# NASA_EARTHDATA_USERNAME=
# NASA_EARTHDATA_PASSWORD=
# NASA_EARTHDATA_TOKEN=
